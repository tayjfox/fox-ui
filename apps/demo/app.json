{
  "name": "kitsUI",
  "description": "A Demo React Native kits UI based application",
  "slug": "kitsui",
  "version": "1.0.0",
  "scheme": "kitsui",
  "orientation": "portrait",
  "icon": "./src/assets/images/app-icon.png",
  "newArchEnabled": true,
  "userInterfaceStyle": "automatic",
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "io.vedla.kitsui",
    "icon": "./src/assets/images/kits-ui.icon",
    "config": {
      "usesNonExemptEncryption": false
    }
  },
  "android": {
    "edgeToEdgeEnabled": true,
    "icon": "./src/assets/images/android-icon.png",
    "adaptiveIcon": {
      "foregroundImage": "./src/assets/images/android-icon.png",
      "monochromeImage": "./src/assets/images/android-icon-monochrome.png",
      "backgroundImage": "./src/assets/images/android-icon-background.png",
      "backgroundColor": "#5a2c72"
    },
    "versionCode": 1,
    "package": "io.vedla.kitsui"
  },
  "web": {
    "favicon": "./src/assets/images/favicon.png",
    "bundler": "metro"
  },
  "owner": "vedla",
  "plugins": [
    "expo-router",
    "expo-font",
    [
      "expo-splash-screen",
      {
        "backgroundColor": "#5a2c72",
        "image": "./src/assets/images/splash-logo.png",
        "imageWidth": 235
      }
    ],
    "expo-web-browser"
  ],
  "extra": {
    "router": {},
    "eas": {
      "projectId": "6891b7ac-8a0a-4e5c-8a6d-e6fdff483ba4"
    }
  },
  "runtimeVersion": {
    "policy": "appVersion"
  },
  "updates": {
    "checkAutomatically": "NEVER",
    "url": "https://u.expo.dev/6891b7ac-8a0a-4e5c-8a6d-e6fdff483ba4"
  }
}